# ==============================================================================
# .gitignore - vibecode
# Loại bỏ file rác, file nhạy cảm, file dung lượng lớn, video, audio & build artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. File đa phương tiện (Video & Audio dung lượng lớn)
# ------------------------------------------------------------------------------
# Video formats
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm
*.m4v
*.vob
*.ogv
*.mts
*.m2ts
*.ts

# Audio formats
*.mp3
*.wav
*.flac
*.aac
*.ogg
*.wma
*.m4a
*.alac
*.aiff
*.opus

# ------------------------------------------------------------------------------
# 2. File nén, file ảnh đĩa & dung lượng lớn
# ------------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.txz
*.7z
*.rar
*.gz
*.iso
*.dmg
*.img
*.pkg

# ------------------------------------------------------------------------------
# 3. File môi trường, cấu hình mật & khóa bảo mật (Secrets / Credentials)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_ed25519
*.secret
credentials.json
service-account*.json

# ------------------------------------------------------------------------------
# 4. File rác hệ điều hành (Windows, macOS, Linux)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 5. IDE, Trình soạn thảo mã nguồn & Tools
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains (IntelliJ, WebStorm, PyCharm, v.v.)
.idea/
*.iws
*.iml
out/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Editors khác
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 6. File thực thi & nhị phân (Binaries & Libraries)
# ------------------------------------------------------------------------------
*.exe
*.dll
*.so
*.dylib
*.app
*.o
*.obj
*.class
*.jar
*.war
*.ear
*.pdb
*.lib
*.a

# ------------------------------------------------------------------------------
# 7. File cơ sở dữ liệu lớn (Databases & Dumps)
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.sql.tar.gz
*.dump
*.bak
*.mdf
*.ldf

# ------------------------------------------------------------------------------
# 8. Log, Cache & File tạm (Temporary files)
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
tmp/
temp/
*.pid
*.seed
*.pid.lock
.cache/
coverage/
*.lcov
.nyc_output/

# ------------------------------------------------------------------------------
# 9. Dependencies & Build Artifacts theo ngôn ngữ
# ------------------------------------------------------------------------------
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
build/
.next/
.nuxt/
.svelte-kit/
.output/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Java / Kotlin / Gradle / Maven
target/
.gradle/
build/

# Go
/bin/
/pkg/

# Rust
/target/
Cargo.lock

# C# / .NET
bin/
obj/
